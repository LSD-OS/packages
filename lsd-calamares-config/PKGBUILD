# Maintainer: LSD_OS Team
pkgname=lsd-calamares-config
pkgver=1.0.0
pkgrel=8
pkgdesc="Calamares installer configuration and launcher for LSD_OS"
arch=('any')
license=('GPL3')
depends=('calamares' 'calamares-extensions' 'qt6-wayland' 'xcb-util-cursor' 'limine')
backup=('etc/calamares/settings.conf')
source=()

package() {
    install -d "${pkgdir}/etc"
    cp -dr --no-preserve=ownership "${startdir}/etc/"* "${pkgdir}/etc/"

    install -d "${pkgdir}/usr/bin"
    install -m 755 "${startdir}/usr/bin/lsd-calamares" "${pkgdir}/usr/bin/lsd-calamares"
    install -m 755 "${startdir}/usr/bin/lsd-install-limine" "${pkgdir}/usr/bin/lsd-install-limine"

    install -d "${pkgdir}/usr/share/applications"
    install -m 644 "${startdir}/usr/share/applications/lsd-calamares.desktop" "${pkgdir}/usr/share/applications/lsd-calamares.desktop"

    chmod 755 "${pkgdir}/etc/calamares"
    chmod 755 "${pkgdir}/etc/calamares/branding"
    chmod 755 "${pkgdir}/etc/calamares/branding/default"
    chmod 755 "${pkgdir}/etc/calamares/modules"
    chmod 755 "${pkgdir}/etc/xdg"
    chmod 755 "${pkgdir}/etc/xdg/autostart"
    chmod 750 "${pkgdir}/etc/sudoers.d"
    chmod 440 "${pkgdir}/etc/sudoers.d/calamares"
    chmod 644 "${pkgdir}/etc/xdg/autostart/calamares.desktop"
}
