#!/usr/bin/env bash
# LSD_OS Limine Bootloader Installer (UEFI Only)
set -e

echo "==> Instalando Limine Bootloader (UEFI)..."

# Identifica UUID da partição raiz recém-instalada
ROOT_DEV=$(findmnt -n -o SOURCE / 2>/dev/null | sed 's/\[.*\]//' || true)
ROOT_UUID=$(findmnt -n -o UUID / 2>/dev/null || blkid -s UUID -o value "$ROOT_DEV" 2>/dev/null || true)

# Se a raiz for Btrfs com subvolume (ex: /@ criado pelo Calamares), inclui rootflags=subvol=...
ROOT_FSTYPE=$(findmnt -n -o FSTYPE / 2>/dev/null || true)
ROOT_FLAGS=""
if [ "$ROOT_FSTYPE" = "btrfs" ]; then
    SUBVOL=$(findmnt -n -o FSROOT / 2>/dev/null || true)
    if [ -n "$SUBVOL" ] && [ "$SUBVOL" != "/" ]; then
        ROOT_FLAGS="rootflags=subvol=${SUBVOL} "
    fi
fi

# Ponto de montagem da partição EFI (/boot ou /boot/efi)
if findmnt -n /boot/efi >/dev/null 2>&1 || [ -d "/boot/efi/EFI" ]; then
    ESP_DIR="/boot/efi"
elif findmnt -n /boot >/dev/null 2>&1 || [ -d "/boot/EFI" ]; then
    ESP_DIR="/boot"
elif [ -d "/boot/efi" ]; then
    ESP_DIR="/boot/efi"
else
    ESP_DIR="/boot"
fi

echo "==> Ponto de montagem da partição ESP: $ESP_DIR"
mkdir -p "$ESP_DIR/EFI/BOOT" "$ESP_DIR/EFI/LSD_OS"

# Se a ESP estiver montada em /boot/efi (separada de /boot), copia kernel, initramfs e microcode para a ESP
# pois o protocolo UEFI do Limine lê de boot():/ (que é a partição FAT32 da ESP)
if [ "$ESP_DIR" != "/boot" ]; then
    echo "==> Sincronizando kernel e initramfs de /boot para $ESP_DIR..."
    cp -fv /boot/vmlinuz-* "$ESP_DIR/" 2>/dev/null || true
    cp -fv /boot/initramfs-*.img "$ESP_DIR/" 2>/dev/null || true
    cp -fv /boot/*-ucode.img "$ESP_DIR/" 2>/dev/null || true

    # Cria hook do pacman para manter o kernel sincronizado na ESP em futuras atualizações
    mkdir -p /etc/pacman.d/hooks
    cat << 'HOOK' > /etc/pacman.d/hooks/99-limine-esp-sync.hook
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/modules/*/vmlinuz
Target = boot/vmlinuz-*
Target = boot/initramfs-*.img
Target = boot/*-ucode.img

[Action]
Description = Sincronizando Kernel e Initramfs com a partição EFI para o Limine...
When = PostTransaction
Exec = /bin/sh -c 'cp -f /boot/vmlinuz-* /boot/initramfs-*.img /boot/efi/ 2>/dev/null || true; cp -f /boot/*-ucode.img /boot/efi/ 2>/dev/null || true'
HOOK
fi

# Copia os binários UEFI x86_64 do Limine
cp -fv /usr/share/limine/BOOTX64.EFI "$ESP_DIR/EFI/BOOT/BOOTX64.EFI" 2>/dev/null || true
cp -fv /usr/share/limine/BOOTIA32.EFI "$ESP_DIR/EFI/BOOT/BOOTIA32.EFI" 2>/dev/null || true
cp -fv /usr/share/limine/BOOTX64.EFI "$ESP_DIR/EFI/LSD_OS/BOOTX64.EFI" 2>/dev/null || true

# Detecta ucode presente (intel ou amd)
UCODE_ENTRY=""
if [ -f "$ESP_DIR/intel-ucode.img" ]; then
    UCODE_ENTRY="    module_path: boot():/intel-ucode.img"
elif [ -f "$ESP_DIR/amd-ucode.img" ]; then
    UCODE_ENTRY="    module_path: boot():/amd-ucode.img"
fi

# Configura o limine.conf na raiz da ESP
cat << CONF > "$ESP_DIR/limine.conf"
timeout: 5
interface_branding: LSD_OS!
term_font_scale: 1x1

/LSD_OS (Linux CachyOS)
    protocol: linux
    kernel_path: boot():/vmlinuz-linux-cachyos
${UCODE_ENTRY}
    module_path: boot():/initramfs-linux-cachyos.img
    kernel_cmdline: root=UUID=${ROOT_UUID} ${ROOT_FLAGS}rw quiet splash

/LSD_OS (Linux CachyOS - Fallback)
    protocol: linux
    kernel_path: boot():/vmlinuz-linux-cachyos
${UCODE_ENTRY}
    module_path: boot():/initramfs-linux-cachyos-fallback.img
    kernel_cmdline: root=UUID=${ROOT_UUID} ${ROOT_FLAGS}rw

/LSD_OS (Linux CachyOS LTS)
    protocol: linux
    kernel_path: boot():/vmlinuz-linux-cachyos-lts
${UCODE_ENTRY}
    module_path: boot():/initramfs-linux-cachyos-lts.img
    kernel_cmdline: root=UUID=${ROOT_UUID} ${ROOT_FLAGS}rw quiet splash

/LSD_OS (Linux CachyOS LTS - Fallback)
    protocol: linux
    kernel_path: boot():/vmlinuz-linux-cachyos-lts
${UCODE_ENTRY}
    module_path: boot():/initramfs-linux-cachyos-lts-fallback.img
    kernel_cmdline: root=UUID=${ROOT_UUID} ${ROOT_FLAGS}rw
CONF

# Também copia para $ESP_DIR/EFI/BOOT/limine.conf e $ESP_DIR/EFI/LSD_OS/limine.conf por garantia
cp -fv "$ESP_DIR/limine.conf" "$ESP_DIR/EFI/BOOT/limine.conf" 2>/dev/null || true
cp -fv "$ESP_DIR/limine.conf" "$ESP_DIR/EFI/LSD_OS/limine.conf" 2>/dev/null || true

# Registra a entrada NVRAM no firmware UEFI
if command -v efibootmgr >/dev/null 2>&1; then
    ESP_DEV=$(findmnt -n -o SOURCE "$ESP_DIR" 2>/dev/null || true)
    if [ -n "$ESP_DEV" ]; then
        DISK="/dev/$(lsblk -no PKNAME "$ESP_DEV" 2>/dev/null || true)"
        PARTNUM=$(lsblk -no PARTN "$ESP_DEV" 2>/dev/null || true)
        if [ -b "$DISK" ] && [ -n "$PARTNUM" ]; then
            echo "==> Registrando entrada UEFI no NVRAM ($DISK p$PARTNUM)..."
            efibootmgr -c -d "$DISK" -p "$PARTNUM" -L "LSD_OS (Limine)" -l "\\EFI\\LSD_OS\\BOOTX64.EFI" 2>/dev/null || true
        fi
    fi
fi

echo "==> Limine UEFI instalado com sucesso!"
