#!/usr/bin/env bash
# LSD_OS Sync Live Environment Settings to Target Installation Disk
set -euo pipefail

TARGET_ROOT="${1:-}"

if [ -z "$TARGET_ROOT" ] || [ "$TARGET_ROOT" = "/" ]; then
    echo "Warning: Target root is empty or /. Refusing to modify live host filesystem." >&2
    exit 0
fi

echo "==> Sincronizando configurações do ambiente live para o alvo: ${TARGET_ROOT}"

# Diretórios base no alvo
mkdir -p "${TARGET_ROOT}/etc"
mkdir -p "${TARGET_ROOT}/etc/skel/.config/cosmic/com.system76.CosmicTheme.Mode/v1"
mkdir -p "${TARGET_ROOT}/usr/share/cosmic/com.system76.CosmicComp/v1"

# 1. Localização (/etc/locale.conf)
if [ -f /etc/locale.conf ]; then
    echo "  -> Sincronizando /etc/locale.conf"
    cp -f /etc/locale.conf "${TARGET_ROOT}/etc/locale.conf"
fi

# 2. Teclado de console (/etc/vconsole.conf)
if [ -f /etc/vconsole.conf ]; then
    echo "  -> Sincronizando /etc/vconsole.conf"
    cp -f /etc/vconsole.conf "${TARGET_ROOT}/etc/vconsole.conf"
fi

# 3. Fuso horário (/etc/localtime e /etc/timezone)
if [ -L /etc/localtime ]; then
    echo "  -> Sincronizando symlink /etc/localtime"
    cp -d -f /etc/localtime "${TARGET_ROOT}/etc/localtime"
elif [ -f /etc/localtime ]; then
    echo "  -> Sincronizando arquivo /etc/localtime"
    cp -f /etc/localtime "${TARGET_ROOT}/etc/localtime"
fi

if [ -f /etc/timezone ]; then
    echo "  -> Sincronizando /etc/timezone"
    cp -f /etc/timezone "${TARGET_ROOT}/etc/timezone"
fi

# 4. Teclado COSMIC (/usr/share/cosmic/com.system76.CosmicComp/v1/xkb_config)
if [ -f /usr/share/cosmic/com.system76.CosmicComp/v1/xkb_config ]; then
    echo "  -> Sincronizando layout de teclado do COSMIC"
    cp -f /usr/share/cosmic/com.system76.CosmicComp/v1/xkb_config \
          "${TARGET_ROOT}/usr/share/cosmic/com.system76.CosmicComp/v1/xkb_config"
fi

# 5. Tema do COSMIC (/etc/skel/.config/cosmic/.../mode)
if [ -f /etc/lsd-welcome/theme ]; then
    echo "  -> Sincronizando tema COSMIC para /etc/skel"
    cp -f /etc/lsd-welcome/theme \
          "${TARGET_ROOT}/etc/skel/.config/cosmic/com.system76.CosmicTheme.Mode/v1/mode"
fi

# 6. Modo de instalação (offline / online)
if [ -f /etc/lsd-welcome/install_mode ]; then
    mkdir -p "${TARGET_ROOT}/etc/lsd-welcome"
    cp -f /etc/lsd-welcome/install_mode "${TARGET_ROOT}/etc/lsd-welcome/install_mode"
fi

echo "==> Sincronização concluída com sucesso."
exit 0
