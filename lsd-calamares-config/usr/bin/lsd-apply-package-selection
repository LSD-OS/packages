#!/usr/bin/env bash
# LSD_OS - Sincroniza pacotes desmarcados e serviços após instalação

# Pacotes pré-instalados na ISO que podem ter sido desmarcados no netinstall
PREINSTALLED=(
    pv
    nano
    micro
    tree
    7zip
    rsync
    lsdfetch
    mesa
    vulkan-intel
    intel-media-driver
    libva-utils
    cosmic
    dconf
    cosmic-monitor
    cosmic-player
    cosmic-store
    cosmic-viewer
    cosmic-terminal
    cosmic-text-editor
    cosmic-wallpapers
    cosmic-greeter-openrc
    brave-bin
    visual-studio-code-bin
)

# 1. Habilita serviços OpenRC caso pacotes correspondentes tenham sido instalados
if pacman -Q bluez-openrc >/dev/null 2>&1; then
    for s in bluetoothd bluetooth; do
        if [ -x "/etc/init.d/$s" ]; then
            rc-update add "$s" default 2>/dev/null || ln -sf "/etc/init.d/$s" "/etc/runlevels/default/$s" 2>/dev/null || true
        fi
    done
fi

if pacman -Q cups-openrc >/dev/null 2>&1; then
    for s in cupsd cups; do
        if [ -x "/etc/init.d/$s" ]; then
            rc-update add "$s" default 2>/dev/null || ln -sf "/etc/init.d/$s" "/etc/runlevels/default/$s" 2>/dev/null || true
        fi
    done
fi

exit 0
