# Maintainer: Wendel <wende08@proton.me>
pkgname=lsd-welcome
pkgver=1.0.0
pkgrel=3
pkgdesc="TUI de boas-vindas da ISO live (idioma, teclado, timezone) e seu serviço dinit"
arch=('any')
url="https://github.com/LSD-OS/lsd-welcome"
license=('GPL3')
depends=('dinit' 'bash' 'sudo' 'kbd' 'curl' 'iputils')
source=(
    'lsd-welcome'
    'lsd-welcome.service'
)
sha256sums=(
    'SKIP'
    'SKIP'
)

package() {
    # Script da TUI (idioma, teclado, timezone) que roda no console antes
    # do greeter na ISO live
    install -d -m 0755 "${pkgdir}/usr/bin"
    install -m 0755 "${srcdir}/lsd-welcome" "${pkgdir}/usr/bin/lsd-welcome"

    # Serviço dinit que sobe o script no tty1: scripted sobre o
    # login.target, sem opção de console (o script abre a tty1 direto —
    # ver lsd-welcome.service). Na ISO live o cosmic-greeter ganha
    # waits-for = lsd-welcome (gate live-only, ver lsd-welcome.service)
    install -d -m 0755 "${pkgdir}/etc/dinit.d"
    install -m 0644 "${srcdir}/lsd-welcome.service" "${pkgdir}/etc/dinit.d/lsd-welcome"
}
