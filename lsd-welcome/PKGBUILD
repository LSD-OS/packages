# Maintainer: Wendel <wende08@proton.me>
pkgname=lsd-welcome
pkgver=1.0.0
pkgrel=7
pkgdesc="TUI de boas-vindas da ISO live (idioma, teclado, timezone) e seu serviço OpenRC"
arch=('any')
url="https://github.com/LSD-OS/lsd-welcome"
license=('GPL3')
depends=('openrc' 'bash' 'sudo' 'kbd' 'curl' 'iputils')
source=(
    'lsd-welcome'
    'lsd-welcome.service'
    'lsd-braille.psfu.gz'
)
noextract=('lsd-braille.psfu.gz')
sha256sums=(
    'SKIP'
    'SKIP'
    'SKIP'
)

package() {
    # Script da TUI (idioma, teclado, timezone) que roda no console antes
    # do greeter na ISO live
    install -d -m 0755 "${pkgdir}/usr/bin"
    install -m 0755 "${srcdir}/lsd-welcome" "${pkgdir}/usr/bin/lsd-welcome"

    # Serviço OpenRC que sobe o script no tty1: executado antes do greeter.
    install -d -m 0755 "${pkgdir}/etc/init.d"
    install -m 0755 "${srcdir}/lsd-welcome.service" "${pkgdir}/etc/init.d/lsd-welcome"

    # Fonte de console PSF2 com suporte completo a Braille (U+2800..U+28FF) e acentos latinos
    install -d -m 0755 "${pkgdir}/usr/share/kbd/consolefonts"
    install -m 0644 "${srcdir}/lsd-braille.psfu.gz" "${pkgdir}/usr/share/kbd/consolefonts/lsd-braille.psfu.gz"
}
