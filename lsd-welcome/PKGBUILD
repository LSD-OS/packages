# Maintainer: Wendel <wende08@proton.me>
pkgname=lsd-welcome
pkgver=2.0.0
pkgrel=3
pkgdesc="Assistente grafico de boas-vindas do LSD_OS"
arch=('any')
url="https://github.com/LSD-OS/lsd-welcome"
license=('GPL3')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita' 'networkmanager' 'sudo' 'kbd' 'curl' 'iputils')
makedepends=('git')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

package() {
    if [ -d "${srcdir}/${pkgname}" ]; then
        cd "${srcdir}/${pkgname}"
    elif [ -d "${startdir}/../../lsd-welcome" ]; then
        cd "${startdir}/../../lsd-welcome"
    fi

    # 1. Executável wrapper Python
    install -d -m 0755 "${pkgdir}/usr/bin"
    install -m 0755 "lsd-welcome" "${pkgdir}/usr/bin/lsd-welcome"

    # 2. Arquivo Desktop de autostart
    install -d -m 0755 "${pkgdir}/etc/xdg/autostart"
    install -m 0644 "lsd-welcome.desktop" "${pkgdir}/etc/xdg/autostart/lsd-welcome.desktop"

    # 3. Código-fonte Python da aplicação (/usr/lib/lsd-welcome/)
    install -d -m 0755 "${pkgdir}/usr/lib/lsd-welcome"
    cp -dr --no-preserve=ownership src/* "${pkgdir}/usr/lib/lsd-welcome/"
    rm -rf "${pkgdir}/usr/lib/lsd-welcome/__pycache__" "${pkgdir}/usr/lib/lsd-welcome/views/__pycache__"

    # 4. Assets gráficos (/usr/share/lsd-welcome/assets/)
    install -d -m 0755 "${pkgdir}/usr/share/lsd-welcome/assets"
    cp -dr --no-preserve=ownership assets/* "${pkgdir}/usr/share/lsd-welcome/assets/"

    # 5. Fonte de console PSF2 com suporte a Braille e acentos latinos
    install -d -m 0755 "${pkgdir}/usr/share/kbd/consolefonts"
    install -m 0644 "lsd-braille.psfu.gz" "${pkgdir}/usr/share/kbd/consolefonts/lsd-braille.psfu.gz"
}
