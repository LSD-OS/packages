# Paleta de Cores em Tons Pastéis (Compatível com 256 cores do console KMS/fbcon)
CLR_RESET=$'\e[0m'
CLR_CLOCK=$'\e[38;5;189m'     # Lavanda suave / Pastel lavender
CLR_TITLE=$'\e[1;38;5;222m'   # Pêssego/Creme dourado suave / Pastel peach
CLR_NAV=$'\e[38;5;146m'       # Ardósia suave / Muted pastel slate
CLR_SEL=$'\e[38;5;255;48;5;67m'  # Fundo azul pastel acinzentado com texto branco suave
CLR_ITEM=$'\e[38;5;252m'      # Texto suave dos itens normais
CLR_LOGO=$'\e[38;5;116m'      # Ciano/Menta pastel / Pastel cyan-mint

term_size() {
    local sz
    sz=$(stty size 2>/dev/null)
    if [ -n "$sz" ]; then
        LINES="${sz%% *}"
        COLUMNS="${sz##* }"
    fi
    LINES="${LINES:-24}"
    COLUMNS="${COLUMNS:-80}"
}

draw_decorations() {
    # Relógio no topo centralizado
    local clk
    clk="$(date +'%H:%M')"
    local clk_col=$(( (COLUMNS - ${#clk}) / 2 + 1 ))
    (( clk_col < 1 )) && clk_col=1
    printf '\e[1;%dH%s%s%s' "$clk_col" "$CLR_CLOCK" "$clk" "$CLR_RESET"

    # Logo ASCII no canto inferior direito
    local logo_len=${#LOGO_LINES[@]}
    local logo_w=30
    local logo_start_row=$(( LINES - logo_len + 1 ))
    (( logo_start_row < 1 )) && logo_start_row=1
    local logo_col=$(( COLUMNS - logo_w ))
    (( logo_col < 1 )) && logo_col=1

    for (( li=0; li<logo_len; li++ )); do
        local r=$(( logo_start_row + li ))
        (( r > LINES )) && break
        printf '\e[%d;%dH%s%s%s' "$r" "$logo_col" "$CLR_LOGO" "${LOGO_LINES[$li]}" "$CLR_RESET"
    done
}

