select_item() {
  local title="$1" arr_name="$2" w="$3"
  local -n items="$arr_name"
  local sel=0
  while :; do
    term_size
    local title_col=$(( (COLUMNS - ${#title}) / 2 + 1 ))
    (( title_col < 1 )) && title_col=1
    local nav_col=$(( (COLUMNS - ${#t_nav}) / 2 + 1 ))
    (( nav_col < 1 )) && nav_col=1
    local opt_col=$(( (COLUMNS - (w + 4)) / 2 + 1 ))
    (( opt_col < 1 )) && opt_col=1

    printf '\e[H\e[J'
    draw_decorations

    printf '\e[4;%dH%s%s%s\e[6;%dH%s%s%s' "$title_col" "$CLR_TITLE" "$title" "$CLR_RESET" "$nav_col" "$CLR_NAV" "$t_nav" "$CLR_RESET"

    local max_display=12 start=0
    if (( sel > max_display / 2 )); then start=$((sel - max_display / 2)); fi
    if (( start + max_display > ${#items[@]} )); then start=$((${#items[@]} - max_display)); fi
    if (( start < 0 )); then start=0; fi

    local cur_row=8
    for i in $(seq $start $((start + max_display - 1))); do
      if (( i >= ${#items[@]} )); then break; fi
      local name="${items[$i]%%|*}"
      local pad=$(( w - ${#name} ))
      (( pad < 0 )) && pad=0
      local spaces
      printf -v spaces '%*s' "$pad" ''
      if (( i == sel )); then
        printf '\e[%d;%dH%s > %s%s %s' "$cur_row" "$opt_col" "$CLR_SEL" "$name" "$spaces" "$CLR_RESET"
      else
        printf '\e[%d;%dH%s   %s%s %s' "$cur_row" "$opt_col" "$CLR_ITEM" "$name" "$spaces" "$CLR_RESET"
      fi
      (( cur_row++ ))
    done

    # -t 0.4: redesenha periodicamente para atualizar o relógio e limpar saídas concorrentes
    if read -rsn3 -t 0.4 k; then
      case $k in
        $'\e[A') ((sel>0)) && ((sel--)) ;;
        $'\e[B') ((sel<${#items[@]}-1)) && ((sel++)) ;;
        '') break ;;
      esac
    fi
  done
  SELECTED_IDX=$sel
}

setup_language() {
  select_item "$t_sel_lang" langs 24
  lang_sel=$SELECTED_IDX
  selected_lang="${langs[$lang_sel]}"
  lang_code="${selected_lang#*|}"; lang_code="${lang_code%%|*}"
  locale_str="${selected_lang##*|}"

  echo "LANG=$locale_str" | sudo tee /etc/locale.conf > /dev/null
  echo "export LANG=$locale_str" | sudo tee /etc/profile.d/locale.sh > /dev/null

  # Env que o wrapper do greeter cosmic (cosmic-greeter-start) sourcinga
  # antes de subir o cosmic-comp: é assim que o idioma escolhido aqui
  # chega à interface do greeter.
  sudo mkdir -p /etc/lsd-welcome
  echo "export LANG=$locale_str" | sudo tee /etc/lsd-welcome/env > /dev/null

  echo "$lang_code" > /tmp/.lsd_welcome_lang 2>/dev/null || true
  export LANG="$locale_str"
  
  apply_translations
}

setup_keyboard() {
  # Ordena layouts sugerindo primeiro os relacionados ao idioma selecionado
  keyboards=()
  for kb in "${all_keyboards[@]}"; do
    IFS='|' read -r _name _l _v _vc _codes <<< "$kb"
    if [[ ",${_codes}," == *",${lang_code},"* ]]; then
      keyboards+=("$kb")
    fi
  done
  for kb in "${all_keyboards[@]}"; do
    IFS='|' read -r _name _l _v _vc _codes <<< "$kb"
    if [[ ",${_codes}," != *",${lang_code},"* ]]; then
      keyboards+=("$kb")
    fi
  done

  select_item "$t_sel_kb" keyboards 32
  kb_sel=$SELECTED_IDX
  selected_kb="${keyboards[$kb_sel]}"
  IFS='|' read -r _name xkb_l xkb_v vconsole_l _codes <<< "$selected_kb"

  # Layout para o cosmic-comp (greeter e sessão): default "de sistema" do
  # cosmic-config em /usr/share/cosmic/... O cosmic-comp lê xkb_config com
  # get() (config do usuário primeiro, system default como fallback), e o
  # greeter roda sem config de usuário, então recebe este layout. Se
  # mudarem o layout no cosmic-settings depois, a config por usuário
  # sobrescreve este default. Formato: RON (cosmic-config usa ron::from_str).
  sudo mkdir -p /usr/share/cosmic/com.system76.CosmicComp/v1
  printf '(rules: "", model: "", layout: "%s", variant: "%s", options: None)\n' \
    "$xkb_l" "$xkb_v" | sudo tee /usr/share/cosmic/com.system76.CosmicComp/v1/xkb_config > /dev/null

  if [ -f /etc/vconsole.conf ]; then
      if grep -q "^KEYMAP=" /etc/vconsole.conf; then
          sudo sed -i -E "s/^KEYMAP=.*/KEYMAP=$vconsole_l/" /etc/vconsole.conf
      else
          echo "KEYMAP=$vconsole_l" | sudo tee -a /etc/vconsole.conf > /dev/null
      fi
  else
      echo "KEYMAP=$vconsole_l" | sudo tee /etc/vconsole.conf > /dev/null
  fi

  sudo loadkeys "$vconsole_l" 2>/dev/null || true
}

setup_timezone() {
  tz_regions=()
  while IFS= read -r r; do
    tz_regions+=("$r")
  done < <(find /usr/share/zoneinfo -maxdepth 1 -mindepth 1 -type d -printf '%f\n' | grep -vE '^(right|posix)$' | sort)

  select_item "$t_sel_reg" tz_regions 22
  local region="${tz_regions[$SELECTED_IDX]}"

  tz_cities=()
  while IFS= read -r c; do
    tz_cities+=("$c")
  done < <(find "/usr/share/zoneinfo/$region" -maxdepth 1 -type f -printf '%f\n' | sort)

  select_item "$t_sel_city ($region)" tz_cities 26
  local city="${tz_cities[$SELECTED_IDX]}"

  tz="$region/$city"

  sudo ln -sf "/usr/share/zoneinfo/$tz" /etc/localtime
  echo "$tz" | sudo tee /etc/timezone > /dev/null
}

# Inicialização de variáveis / localização padrão (default: en)
lang_code="en"
if [ -f /tmp/.lsd_welcome_lang ]; then
  lang_code=$(cat /tmp/.lsd_welcome_lang 2>/dev/null)
fi
[ -z "$lang_code" ] && lang_code="en"
apply_translations

if [ -f /etc/vconsole.conf ]; then
  xkb_l=$(grep "^KEYMAP=" /etc/vconsole.conf | cut -d= -f2 | tr -d '"')
  xkb_v=""
else
  xkb_l="us"
fi

if [ -f /etc/timezone ]; then
  tz=$(cat /etc/timezone)
elif [ -L /etc/localtime ]; then
  tz=$(readlink -f /etc/localtime | sed 's|.*/zoneinfo/||')
else
  tz="Europe/Paris"
fi

s=0
while :; do
  menu_opt=("$t_cl" "$t_kb" "$t_tz" "$t_l" "$t_c")

  # Determina largura do menu para centralização
  max_opt_len=0
  for opt in "${menu_opt[@]}"; do
    (( ${#opt} > max_opt_len )) && max_opt_len=${#opt}
  done
  menu_box_w=$(( max_opt_len + 4 ))

  while :; do
    term_size
    title_col=$(( (COLUMNS - ${#t_w}) / 2 + 1 ))
    (( title_col < 1 )) && title_col=1
    nav_col=$(( (COLUMNS - ${#t_nav}) / 2 + 1 ))
    (( nav_col < 1 )) && nav_col=1
    opt_col=$(( (COLUMNS - menu_box_w) / 2 + 1 ))
    (( opt_col < 1 )) && opt_col=1

    printf '\e[H\e[J'
    draw_decorations

    # Título "Welcome to LSD_OS!" e instruções centralizados
    printf '\e[4;%dH%s%s%s\e[6;%dH%s%s%s' "$title_col" "$CLR_TITLE" "$t_w" "$CLR_RESET" "$nav_col" "$CLR_NAV" "$t_nav" "$CLR_RESET"

    # Opções do menu principal
    cur_row=9
    for i in 0 1 2 3 4; do
      opt_name="${menu_opt[$i]}"
      opt_pad=$(( max_opt_len - ${#opt_name} ))
      (( opt_pad < 0 )) && opt_pad=0
      printf -v opt_spaces '%*s' "$opt_pad" ''
      if (( i == s )); then
        printf '\e[%d;%dH%s > %s%s %s' "$cur_row" "$opt_col" "$CLR_SEL" "$opt_name" "$opt_spaces" "$CLR_RESET"
      else
        printf '\e[%d;%dH%s   %s%s %s' "$cur_row" "$opt_col" "$CLR_ITEM" "$opt_name" "$opt_spaces" "$CLR_RESET"
      fi
      (( cur_row += 2 ))
    done

    # -t 0.4: redesenha periodicamente (mantém o relógio atualizado)
    if read -rsn3 -t 0.4 k; then
      case $k in
        $'\e[A') ((s>0)) && ((s--)) ;;
        $'\e[B') ((s<4)) && ((s++)) ;;
        '') break ;;
      esac
    fi
  done

  case $s in
    0)
      setup_language
      ;;
    1)
      setup_keyboard
      ;;
    2)
      setup_timezone
      ;;
    3)
      # Iniciar ISO live: sai 0 => o serviço dinit completa e o greeter
      # sobe (cosmic-greeter tem waits-for = lsd-welcome).
      exit 0
      ;;
    4)
      # Linha de comando: este bash É o processo do serviço; quando ele
      # terminar (exit), o greeter sobe. "lsd-welcome" reabre este menu.
      printf '\e[32;1H%s\n\n' "$t_e"
      printf '\e[?25h\e[0m'
      exec /bin/bash
      ;;
  esac
done
