#!/usr/bin/env python3
"""LSD-Welcome Application Launcher."""

import sys
import os
from pathlib import Path

# Add possible runtime paths to sys.path
SCRIPT_DIR = Path(__file__).resolve().parent
CANDIDATE_PATHS = [
    "/usr/lib/lsd-welcome",
    "/usr/share/lsd-welcome",
    str(SCRIPT_DIR / "src"),
    str(SCRIPT_DIR.parent.parent),  # repo root for local execution
]

for p in CANDIDATE_PATHS:
    if os.path.isdir(p) and p not in sys.path:
        sys.path.insert(0, p)

try:
    from packages.lsd_welcome_pkg.app import main
except ImportError:
    from app import main

if __name__ == "__main__":
    sys.exit(main())
