#!/usr/bin/env bash

# Ideias pendentes:
# - Adicionar verificador de versão.
# - Adicionar sistema de versionamento no script before squashfs.
# - Mudar script do calamares (contém comandos openrc).

# No boot roda via dinit SEM runs-on-console: o login.target da Artix
# (type = internal + runs-on-console) segura o console para sempre e um
# serviço runs-on-console ficaria preso na fila ("waiting for console").
# Em vez disso, abre a tty1 diretamente — o mesmo mecanismo do agetty
# (é por isso que os getty@ttyN funcionam sem opção de console). Se já
# tem terminal (usuário rodou "lsd-welcome" num shell), usa o que tem.
if [ ! -t 0 ] && [ -e /dev/tty1 ]; then
    exec </dev/tty1 >/dev/tty1 2>/dev/tty1
fi

export LANG=C.UTF-8
export LC_ALL=C.UTF-8
printf '\e%G'

# Carrega a fonte de console com suporte a Braille no TTY para renderizar o logo perfeitamente
if [ -t 0 ] || [ -e /dev/tty1 ]; then
    setfont /usr/share/kbd/consolefonts/lsd-braille.psfu.gz 2>/dev/null || \
    setfont "${0%/*}/lsd-braille.psfu.gz" 2>/dev/null || \
    setfont lsd-braille 2>/dev/null || true
fi

# No boot roda na tty1 (aberta acima): silencia as mensagens do kernel
# para não sujarem a TUI.
sudo dmesg -n 1 2> /dev/null || true

# Teste de conexão em segundo plano enquanto o usuário configura o ambiente:
# Define se a instalação pelo Calamares será em modo online (atualizando pacotes)
# ou offline (usando apenas a imagem local da ISO).
check_connection_bg() {
    sudo mkdir -p /etc/lsd-welcome
    if [ ! -f /etc/lsd-welcome/install_mode ]; then
        echo "offline" | sudo tee /etc/lsd-welcome/install_mode > /dev/null
    fi
    for _ in 1 2 3 4 5; do
        if curl -fsI --max-time 4 https://archlinux.org >/dev/null 2>&1 || \
           curl -fsI --max-time 4 https://artixlinux.org >/dev/null 2>&1 || \
           ping -c 1 -W 3 1.1.1.1 >/dev/null 2>&1; then
            echo "online" | sudo tee /etc/lsd-welcome/install_mode > /dev/null
            if [ -f /etc/calamares/modules/packages.conf ]; then
                sudo sed -i 's/^update_db:.*/update_db: true/' /etc/calamares/modules/packages.conf
                sudo sed -i 's/^update_system:.*/update_system: true/' /etc/calamares/modules/packages.conf
            fi
            return 0
        fi
        sleep 2
    done
    echo "offline" | sudo tee /etc/lsd-welcome/install_mode > /dev/null
    if [ -f /etc/calamares/modules/packages.conf ]; then
        sudo sed -i 's/^update_db:.*/update_db: false/' /etc/calamares/modules/packages.conf
        sudo sed -i 's/^update_system:.*/update_system: false/' /etc/calamares/modules/packages.conf
    fi
}
check_connection_bg </dev/null >/dev/null 2>&1 &

