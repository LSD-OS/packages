# TUI de boas-vindas da ISO live (idioma, layout de teclado, timezone).
# Roda no console (tty1) antes do greeter: "Iniciar ISO live" sai 0 e o
# greeter sobe; "linha de comando" vira este processo e o greeter só sobe
# quando o bash terminar. O gate está no serviço cosmic-greeter
# (waits-for = lsd-welcome, anexado na build da ISO em
# run_before_squashfs.sh — fail-open: se o welcome falhar, o greeter
# sobe mesmo assim).
type            = scripted
command         = /usr/bin/lsd-welcome
depends-on      = login.target
options         = runs-on-console
