pkgname=power-profiles-daemon-openrc
pkgver=1.0.0
pkgrel=1
pkgdesc="Serviço OpenRC para o power-profiles-daemon"
arch=('any')
url="https://gitlab.freedesktop.org/upower/power-profiles-daemon"
license=('GPL3')
depends=('power-profiles-daemon' 'openrc' 'dbus-openrc')
provides=('init-power-profiles-daemon' 'power-profiles-daemon-openrc')
conflicts=('init-power-profiles-daemon')
source=(
    'power-profiles-daemon'
)
sha256sums=(
    'SKIP'
)

package() {
    install -d -m 0755 "${pkgdir}/etc/init.d"
    install -m 0755 "${srcdir}/power-profiles-daemon" "${pkgdir}/etc/init.d/power-profiles-daemon"
}
