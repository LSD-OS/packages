From 750503307f9e463b72fb7d668f6162640092f28c Mon Sep 17 00:00:00 2001
From: artoo <artoo@artixlinux.org>
Date: Fri, 9 Oct 2026 19:59:53 +0200
Subject: [PATCH] arrtix meson install

---
 meson.build       | 2 +-
 meson_options.txt | 2 ++
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/meson.build b/meson.build
index 0a556709..f6d7f701 100644
--- a/meson.build
+++ b/meson.build
@@ -60,7 +60,7 @@ bindir = get_option('prefix') / get_option('bindir')
 libdir = get_option('prefix') / get_option('libdir')
 pluginsdir = libdir / 'rc/plugins'
 libexecdir = get_option('prefix') / get_option('libexecdir')
-rc_libexecdir = libexecdir / 'rc'
+rc_libexecdir = libexecdir / get_option('librcdir')
 rc_bindir = rc_libexecdir / 'bin'
 rc_sbindir = rc_libexecdir / 'sbin'
 rc_shdir = rc_libexecdir / 'sh'
diff --git a/meson_options.txt b/meson_options.txt
index 2bff0d90..2dee74e0 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -35,3 +35,5 @@ option('rc_path', type: 'array',
     if setting a custom compile-time time is strictly necessary, it is recommended to
     set it as close to the default as possible
   ''')
+option('librcdir', type : 'string', value : 'rc',
+  description : 'default location of rc libexec dir')
-- 
2.55.0

