# Maintainer: Wendel <wende08@proton.me>
pkgname=lsdfetch
pkgver=1.0.0
pkgrel=1
pkgdesc="Wrapper para fastfetch com tema e logo do LSD-OS"
arch=('any')
url="https://github.com/LSD-OS/packages"
license=('GPL3')
depends=('bash' 'fastfetch' 'chafa')
source=(
    'lsdfetch'
    'config.jsonc'
    'lsd.png'
)
sha256sums=(
    'SKIP'
    'SKIP'
    'SKIP'
)

package() {
    # Wrapper executável
    install -d -m 0755 "${pkgdir}/usr/bin"
    install -m 0755 "${srcdir}/lsdfetch" "${pkgdir}/usr/bin/lsdfetch"

    # Recursos (config e logo png)
    install -d -m 0755 "${pkgdir}/usr/share/lsdfetch"
    install -m 0644 "${srcdir}/config.jsonc" "${pkgdir}/usr/share/lsdfetch/config.jsonc"
    install -m 0644 "${srcdir}/lsd.png" "${pkgdir}/usr/share/lsdfetch/lsd.png"
}
