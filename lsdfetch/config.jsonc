
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "source": "/usr/share/lsdfetch/lsd.png",
      "type": "chafa",
      "position": "left",
      "width": 32,
      "height": 18,
      "padding": {
        "top": 0,
        "left": 0,
        "right": 2
      }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "\u001b[1;36m{user-name}\u001b[0m\u001b[95m@\u001b[0m\u001b[1;34m{host-name}"
        },
        {
            "type": "custom",
            "format": ""
        },
        {
            "type": "os",
            "key": "\u001b[34m "
        },
        {
            "type": "kernel",
            "key": "\u001b[34m "
        },
        {
            "type": "packages",
            "key": "\u001b[34m󰏖 "
        },
        {
            "type": "shell",
            "key": "\u001b[34m "
        },
        {
            "type": "terminal",
            "key": "\u001b[34m "
        },
        {
            "type": "wm",
            "key": "\u001b[34m "
        },
        {
            "type": "cpu",
            "key": "\u001b[34m "
        },
        {
            "type": "gpu",
            "key": "\u001b[34m󰢮 "
        },
        {
            "type": "memory",
            "key": "\u001b[34m󰍛 "
        },
        {
            "type": "uptime",
            "key": "\u001b[34m "
        },
        {
            "type": "custom",
            "format": ""
        },
        "break"
    ]
}
